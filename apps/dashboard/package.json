{
  "name": "@crosscheck/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "CrossCheck dashboard/report UI — a presentation layer over apps/api. No identity/program/comparison logic lives here — see docs/DECISIONS.md ADR-011.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crosscheck/core": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
