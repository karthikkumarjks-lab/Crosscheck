{
  "name": "@crosscheck/website-quality",
  "version": "0.0.0",
  "private": true,
  "description": "Website Quality module — landing page ingestion, extraction, and understanding (Sprint 2 scope). See docs/design/SPRINT_2_IMPLEMENTATION_PLAN.md.",
  "type": "module",
  "main": "dist/analyze.js",
  "types": "dist/analyze.d.ts",
  "bin": {
    "wq-analyze": "dist/cli.js",
    "wq-compare": "dist/compareCli.js",
    "wq-discover-compare": "dist/discoverAndCompareCli.js",
    "wq-discover-compare-many": "dist/discoverAndCompareManyCli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/data && cp src/data/*.json dist/data/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crosscheck/core": "*",
    "blockhash-core": "^0.1.0",
    "cheerio": "^1.0.0",
    "dictionary-en": "^4.0.0",
    "jimp": "^1.6.1",
    "nspell": "^2.1.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/nspell": "^2.1.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
